      objectReference: {fileID: 0}
    - target: {fileID: 3069120216388199022, guid: a5dff51da41e8474980de5173f8b8723,
        type: 3}
      propertyPath: message
      value: "Alright, I will take over the driving from here, press tab to switch
        your role to the Observer.\n\nYou can turn our turret by using your A/D keys
        and the barrel up and down by using W/S keys. \n\nWhen you have you turret
        alligned with a target, just say the word (by pressing Q) and I will fire!
        If we miss, just reload the gun by pressing R. \n\nYou wont have the Q button
        when the real fighting starts, so communicating with your driver is essential!\n\nOnce
        we have taken out these stationary targets, we will move on to something
        more challenging."
      objectReference: {fileID: 0}
    - target: {fileID: 5262733661499909651, guid: a5dff51da41e8474980de5173f8b8723,
        type: 3}
      propertyPath: m_Layer
      value: 2
      objectReference: {fileID: 0}
    - target: {fileID: 7287634498788487317, guid: a5dff51da41e8474980de5173f8b8723,
        type: 3}
      propertyPath: m_Name
      value: TutorialTrigger (3)
      objectReference: {fileID: 0}
    - target: {fileID: 7287634498788487317, guid: a5dff51da41e8474980de5173f8b8723,
        type: 3}
