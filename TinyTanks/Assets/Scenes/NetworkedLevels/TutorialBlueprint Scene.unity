    - target: {fileID: 3069120216388199022, guid: a5dff51da41e8474980de5173f8b8723,
        type: 3}
      propertyPath: message
      value: "Welcome to your first day of training cadet! I am General Gearbox and
        I will be teaching you the basics!  \n\nHere you will learn the basics.\n\nCurrently
        you are in the Driver position.\nThe Driver will be able to drive the tank
        around, as the name suggests.  \nYou controll your Right track and Left Track
        separately.\n\nGive it a spin!\nTry pressing w/s keys and \u23F6/\u23F7 to
        drive around and I will meet you at the next marker."
      objectReference: {fileID: 0}
