      propertyPath: title
      value: Ramps!
      objectReference: {fileID: 0}
    - target: {fileID: 3069120216388199022, guid: a5dff51da41e8474980de5173f8b8723,
        type: 3}
      propertyPath: message
      value: "Very good!\n\nDuring Gameplay you will encounter these ramps.\nYou
        will need some momentum to get up a ramp,  depending on the tank you are
        using this will be slower.\n\nThey can be used to gain a height advantage
        over your oponents or for an overview of your surroundings, however, be carefull
        because you will stand out! \n\nTry driving over this ramp and I'll see you
        on the other side."
      objectReference: {fileID: 0}
